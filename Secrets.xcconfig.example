// Secrets.xcconfig.example — template for your own SolarEdge V2 credentials.
//
//   cp Secrets.xcconfig.example Secrets.xcconfig
//   # fill in the four values below, then:
//   xcodegen
//
// Secrets.xcconfig is gitignored and must never be committed. This template is.
//
// HOW TO GET THESE
// ----------------
// 1. Create a free SolarEdge developer account at https://api-docs.solaredge.com
//    (Free tier: 2,000 credits/month, which is plenty for one site — see
//    "Credit budget" in the README).
// 2. Create an Application with access type "Site Access" and scope SITE_DATA.
//    Copy its Client ID and Client Secret (the secret is shown once).
// 3. Run the one-time consent flow to mint a refresh token:
//
//      tools/se-token.sh init
//      tools/se-token.sh authorize          # open the URL, approve your site
//      tools/se-token.sh exchange '<the full redirect URL from the address bar>'
//
//    The script stores everything in ~/.config/semonitor/se-api.env and prints
//    your site id. Copy the four values across with:
//
//      tools/se-token.sh xcconfig > Secrets.xcconfig
//
// WHY THE SECRET IS HERE AND NOT ON THE WATCH
// -------------------------------------------
// SolarEdge's OAuth refresh requires the client secret, so a personal build
// embeds it. That is acceptable for an app you build and install on your own
// watch and nowhere else. Do NOT distribute a binary built from this file —
// that would expose your secret to whoever installs it, and SolarEdge's terms
// forbid it. See "Build your own" in the README.

SE_CLIENT_ID = your_client_id_here
SE_CLIENT_SECRET = your_client_secret_here
SE_REFRESH_TOKEN = your_refresh_token_here
SE_SITE_ID = 0

// Your Apple Developer Team ID (Developer portal -> Membership details).
// It lives here rather than in project.yml because it is personal to you —
// and because `xcodegen` regenerates the .xcodeproj from scratch, so a Team
// picked by hand in Xcode is wiped on every regeneration.
SE_DEVELOPMENT_TEAM = YOURTEAMID
